:root {
  --bg: #040c09;
  --bg-alt: #0a1813;
  --panel: rgba(9, 20, 18, 0.78);
  --panel-strong: rgba(12, 24, 22, 0.9);
  --glass-edge: rgba(106, 255, 210, 0.2);
  --emerald: #3ef2b3;
  --emerald-strong: #29d39a;
  --teal: #5fe4ff;
  --white: #edfdf8;
  --muted: rgba(230, 255, 246, 0.75);
  --muted-soft: rgba(230, 255, 246, 0.55);
  --shadow: rgba(62, 242, 179, 0.28);
  --shadow-strong: rgba(54, 212, 255, 0.2);
  --danger: #ff6a8c;
  --border-radius: 24px;
  --container: min(1180px, calc(100vw - 28px));
  --navy: #081612;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at top, rgba(33, 151, 116, 0.17), transparent 28%),
    radial-gradient(circle at bottom right, rgba(87, 228, 255, 0.10), transparent 30%),
    linear-gradient(180deg, #020905 0%, #07140f 30%, #020907 100%);
  color: var(--white);
  overflow-x: hidden;
}

img {
  max-width: 100%;
  display: block;
}

button,
a {
  font: inherit;
}

button {
  border: 0;
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--emerald);
  outline-offset: 3px;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.container {
  width: var(--container);
  margin: 0 auto;
}

.bg-grid {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 255, 210, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 255, 210, 0.03) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: radial-gradient(circle at center, black 46%, transparent 100%);
  pointer-events: none;
}

.particles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.8;
}

.particle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 255, 190, 0.9), rgba(94, 255, 190, 0.12));
  box-shadow: 0 0 14px rgba(94, 255, 190, 0.45);
  transform: translateY(0);
  animation: floatParticle linear infinite;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0 10px;
  backdrop-filter: blur(10px);
}

.brand-wrap {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  position: relative;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(8, 22, 18, 0.72);
  border: 1px solid var(--glass-edge);
  box-shadow: 0 0 25px rgba(62, 242, 179, 0.16);
}

.brand-mark__hex {
  position: relative;
  width: 20px;
  height: 20px;
  border: 2px solid var(--emerald);
  transform: rotate(30deg);
  border-radius: 8px;
  box-shadow: 0 0 18px rgba(62, 242, 179, 0.6);
}

.brand-mark__hex::before,
.brand-mark__hex::after {
  content: "";
  position: absolute;
  inset: 3px;
  border: 2px solid rgba(94, 228, 255, 0.95);
  border-radius: 6px;
}

.brand-name {
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.tiny-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 14px;
  border-radius: 999px;
  text-decoration: none;
  color: var(--white);
  border: 1px solid rgba(62, 242, 179, 0.4);
  background: rgba(9, 28, 23, 0.7);
  box-shadow: 0 0 18px rgba(62, 242, 179, 0.12);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.hero {
  display: grid;
  grid-template-columns: 1fr;
  align-items: center;
  gap: 28px;
  padding: 28px 0 30px;
}

.hero-copy {
  text-align: center;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(94, 228, 255, 0.25);
  background: rgba(10, 24, 20, 0.85);
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.eyebrow-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--emerald), var(--teal));
  box-shadow: 0 0 12px rgba(94, 255, 190, 0.75);
}

.hero h1 {
  margin: 0;
  font-size: clamp(2.5rem, 7vw, 5.3rem);
  line-height: 0.96;
  letter-spacing: -0.055em;
}

.hero p {
  max-width: 620px;
  margin: 18px auto 0;
  color: var(--muted);
  font-size: clamp(1rem, 2.2vw, 1.12rem);
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  margin-top: 26px;
}

.primary-btn,
.secondary-btn,
.invite-btn,
.upgrade-card button,
.mini-card__content button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58px;
  width: min(100%, 440px);
  padding: 18px 22px;
  border-radius: 18px;
  text-decoration: none;
  letter-spacing: 0.06em;
  font-weight: 800;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.primary-btn {
  color: #03160f;
  background: linear-gradient(135deg, var(--emerald) 0%, #85ffd1 40%, var(--teal) 100%);
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 0 20px rgba(62, 242, 179, 0.4), 0 10px 30px rgba(67, 209, 255, 0.12);
}

.secondary-btn {
  color: var(--white);
  background: rgba(12, 25, 22, 0.7);
  border: 1px solid rgba(94, 228, 255, 0.2);
  box-shadow: 0 0 18px rgba(94, 228, 255, 0.12);
}

.primary-btn:hover,
.secondary-btn:hover,
.invite-btn:hover,
.upgrade-card button:hover,
.mini-card__content button:hover,
.tiny-cta:hover {
  transform: translateY(-1px);
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.phone-frame {
  position: relative;
  width: min(100%, 380px);
  padding: 18px 14px 14px;
  border-radius: 34px;
  background: linear-gradient(180deg, rgba(22, 40, 35, 0.95), rgba(7, 16, 15, 0.96));
  border: 1px solid rgba(126, 255, 213, 0.22);
  box-shadow: 0 20px 50px rgba(6, 14, 12, 0.8), 0 0 40px rgba(62, 242, 179, 0.12);
  animation: gentleFloat 6s ease-in-out infinite;
}

.phone-notch {
  width: 36%;
  height: 20px;
  margin: 2px auto 14px;
  border-radius: 12px;
  background: rgba(12, 18, 17, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.screen {
  padding: 18px 14px 16px;
  border-radius: 26px;
  background: linear-gradient(180deg, rgba(7, 18, 16, 0.92), rgba(10, 20, 18, 0.92));
  border: 1px solid rgba(128, 255, 211, 0.14);
}

.screen-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 0.7rem;
  color: var(--muted-soft);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.chip {
  padding: 5px 9px;
  border-radius: 999px;
  background: rgba(62, 242, 179, 0.12);
  border: 1px solid rgba(62, 242, 179, 0.2);
  color: var(--emerald);
  font-size: 0.58rem;
}

.screen-balance {
  margin-top: 16px;
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 800;
  letter-spacing: -0.05em;
}

.screen-balance small {
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.coin-stage {
  display: grid;
  place-items: center;
  min-height: 170px;
  position: relative;
  margin-top: 12px;
}

.coin-stage::before,
.coin-stage::after {
  content: "";
  position: absolute;
  inset: auto;
  width: 70%;
  height: 70%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(62, 242, 179, 0.12), transparent 68%);
  filter: blur(16px);
}

.coin-core {
  display: grid;
  place-items: center;
  width: 126px;
  height: 126px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #fbfffe 0%, #a5ffe1 20%, #3ef2b3 42%, #14a277 100%);
  border: 3px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 0 25px rgba(62, 242, 179, 0.7), 0 0 60px rgba(62, 242, 179, 0.28);
  color: rgba(3, 22, 15, 0.82);
  font-weight: 900;
  font-size: 2.2rem;
  transform: rotate(-10deg);
  animation: coinPulse 2.4s ease-in-out infinite;
}

.tap-indicator {
  text-align: center;
  margin-top: 10px;
  color: var(--emerald);
  font-size: 0.86rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.energy-wrap {
  margin-top: 16px;
}

.energy-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.05em;
  margin-bottom: 8px;
}

.progress-bar {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
  border: 1px solid rgba(62, 242, 179, 0.12);
}

.progress-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--emerald) 0%, var(--teal) 100%);
  box-shadow: 0 0 18px rgba(62, 242, 179, 0.5);
}

.mini-cards {
  display: grid;
  gap: 10px;
  margin-top: 18px;
}

.mini-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px;
  border-radius: 15px;
  background: rgba(12, 23, 22, 0.7);
  border: 1px solid rgba(128, 255, 211, 0.1);
}

.mini-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(62, 242, 179, 0.1);
  border: 1px solid rgba(62, 242, 179, 0.24);
  font-size: 1.1rem;
}

.mini-card__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  color: var(--white);
}

.mini-card__content span {
  display: block;
  font-size: 0.62rem;
  opacity: 0.76;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.mini-card__content strong {
  display: block;
  font-size: 0.8rem;
}

.mini-card__content button,
.upgrade-card button {
  width: auto;
  min-height: 34px;
  padding: 8px 12px;
  border-radius: 10px;
  color: #04170d;
  background: linear-gradient(135deg, #8effd5 0%, var(--teal) 100%);
  letter-spacing: 0.05em;
  font-size: 0.62rem;
  font-weight: 800;
}

.info-section {
  padding-top: 24px;
  padding-bottom: 8px;
}

.section-heading {
  text-align: center;
  margin-bottom: 22px;
}

.section-kicker {
  display: inline-block;
  margin-bottom: 10px;
  color: var(--emerald);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.section-heading h2,
.final-cta__panel h2 {
  margin: 0;
  font-size: clamp(2rem, 5vw, 3rem);
  letter-spacing: -0.05em;
}

.card-grid {
  display: grid;
  gap: 18px;
}

.four-up {
  grid-template-columns: 1fr;
}

.three-up {
  grid-template-columns: 1fr;
}

.glass-card {
  position: relative;
  background: linear-gradient(180deg, rgba(12, 24, 20, 0.84), rgba(8, 16, 14, 0.82));
  border: 1px solid rgba(118, 255, 208, 0.17);
  border-radius: var(--border-radius);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 20px 30px rgba(10, 16, 14, 0.22);
  backdrop-filter: blur(10px);
}

.feature-card {
  padding: 24px 20px 20px;
  text-align: center;
}

.feature-icon {
  display: grid;
  place-items: center;
  width: 62px;
  height: 62px;
  margin: 0 auto 16px;
  border-radius: 18px;
  background: rgba(62, 242, 179, 0.08);
  border: 1px solid rgba(62, 242, 179, 0.2);
  box-shadow: 0 0 18px rgba(62, 242, 179, 0.18);
  color: var(--emerald);
  font-size: 1.6rem;
}

.feature-card h3,
.challenge-card h3,
.upgrade-card h3 {
  margin: 0;
  font-size: 1.2rem;
  letter-spacing: 0.08em;
}

.feature-card p,
.challenge-card p,
.upgrade-card p,
.invite-copy p {
  margin: 10px 0 0;
  color: var(--muted);
  line-height: 1.7;
}

.challenge-grid {
  display: grid;
  gap: 18px;
}

.challenge-card {
  padding: 22px 18px 20px;
}

.challenge-label {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--emerald);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  font-weight: 800;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin: 16px 0 12px;
  color: var(--muted-soft);
  font-size: 0.76rem;
}

.upgrade-card {
  padding: 18px 18px 20px;
}

.upgrade-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.upgrade-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(62, 242, 179, 0.08);
  border: 1px solid rgba(62, 242, 179, 0.2);
  color: var(--emerald);
  font-size: 1.2rem;
}

.upgrade-level {
  color: var(--emerald);
  font-size: 0.74rem;
  letter-spacing: 0.18em;
  font-weight: 800;
}

.leaderboard-panel {
  padding: 18px 16px 12px;
}

.leaderboard-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}

.leaderboard-list li {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  padding: 12px 12px;
  border-radius: 14px;
  background: rgba(11, 19, 18, 0.7);
  border: 1px solid rgba(118, 255, 208, 0.08);
}

.rank {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--emerald), var(--teal));
  color: #06130f;
  font-weight: 800;
  font-size: 0.9rem;
}

.name {
  font-weight: 700;
  color: var(--white);
}

.score {
  color: var(--emerald);
  font-weight: 700;
  font-size: 0.82rem;
  white-space: nowrap;
}

.leaderboard-note {
  margin: 18px 0 0;
  text-align: center;
  color: var(--muted);
}

.invite-panel {
  display: grid;
  gap: 18px;
  padding: 22px 18px;
}

.invite-copy p {
  margin-top: 0;
  font-size: 1.02rem;
}

.invite-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.invite-stats > div {
  padding: 12px 10px;
  border-radius: 14px;
  background: rgba(10, 18, 17, 0.75);
  border: 1px solid rgba(118, 255, 208, 0.08);
}

.label {
  display: block;
  color: var(--muted-soft);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.invite-stats strong {
  display: block;
  margin-top: 6px;
  font-size: 1.5rem;
  letter-spacing: -0.05em;
}

.invite-visual {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 132px;
  border-radius: 18px;
  background: radial-gradient(circle at top, rgba(62, 242, 179, 0.12), rgba(8, 16, 14, 0.2));
  border: 1px solid rgba(118, 255, 208, 0.1);
}

.invite-orb {
  width: 108px;
  height: 108px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #d8fff2 0%, #7af7c6 18%, #3ef2b3 38%, #1aaa7e 100%);
  box-shadow: 0 0 28px rgba(62, 242, 179, 0.48);
}

.invite-bubble {
  position: absolute;
  right: 24%;
  top: 18%;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--teal), var(--emerald));
  color: #02150f;
  font-weight: 900;
  box-shadow: 0 0 18px rgba(62, 242, 179, 0.5);
}

.invite-btn {
  width: 100%;
}

.final-cta {
  padding-top: 26px;
  padding-bottom: 20px;
}

.final-cta__panel {
  padding: 28px 18px 22px;
  text-align: center;
  background: linear-gradient(180deg, rgba(10, 25, 21, 0.92), rgba(6, 15, 12, 0.92));
  border-color: rgba(122, 255, 210, 0.18);
  box-shadow: 0 0 30px rgba(62, 242, 179, 0.16), 0 18px 40px rgba(6, 15, 12, 0.65);
}

.final-cta__panel p {
  margin: 12px 0 20px;
  color: var(--muted);
  font-size: 1.05rem;
}

.huge-btn {
  width: min(100%, 520px);
  min-height: 68px;
  font-size: clamp(0.82rem, 2vw, 1rem);
}

.footer {
  display: grid;
  gap: 18px;
  padding: 16px 0 42px;
  text-align: center;
}

.footer-brand {
  justify-content: center;
}

.footer-tag {
  color: var(--muted);
  font-size: 1rem;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12px 18px;
}

.footer-links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.9rem;
}

.reveal-on-scroll {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal-on-scroll.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (min-width: 640px) {
  .hero-actions {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
  }

  .four-up {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .three-up {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .invite-panel {
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
  }

  .invite-btn {
    grid-column: 1 / -1;
  }
}

@media (min-width: 900px) {
  .hero {
    grid-template-columns: 1.04fr 0.96fr;
    gap: 48px;
    padding-top: 38px;
  }

  .hero-copy {
    text-align: left;
  }

  .hero p {
    margin-left: 0;
  }

  .hero-actions {
    justify-content: flex-start;
  }

  .three-up {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .challenge-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .invite-panel {
    grid-template-columns: 1.2fr 0.8fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }

  .reveal-on-scroll {
    opacity: 1;
    transform: none;
  }
}

@keyframes floatParticle {
  0% {
    transform: translate3d(0, 0, 0) scale(0.9);
    opacity: 0;
  }
  15% {
    opacity: 0.9;
  }
  50% {
    transform: translate3d(14px, -24px, 0) scale(1.2);
    opacity: 0.8;
  }
  100% {
    transform: translate3d(-10px, -48px, 0) scale(0.8);
    opacity: 0;
  }
}

@keyframes gentleFloat {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes coinPulse {
  0%,
  100% {
    transform: rotate(-10deg) scale(1);
  }
  50% {
    transform: rotate(6deg) scale(1.06);
  }
}

@media (max-width: 360px) {
  .brand-name {
    font-size: 0.88rem;
  }

  .topbar {
    padding-top: 14px;
  }

  .screen-balance {
    font-size: 1.5rem;
  }

  .challenge-label,
  .eyebrow,
  .section-kicker {
    letter-spacing: 0.1em;
  }
}

@media (max-width: 420px) {
  .hero {
    padding-top: 6px;
  }

  .primary-btn, .secondary-btn, .invite-btn {
    letter-spacing: 0.05em;
    font-size: 0.78rem;
  }
}

@media (min-width: 480px) {
  .topbar {
    padding-top: 20px;
  }
}

@media (max-width: 360px) {
  .hero-actions {
    gap: 10px;
  }
}

@media (max-width: 480px) {
  .footer-links {
    gap: 10px 15px;
  }
}

@supports not (backdrop-filter: blur(10px)) {
  .glass-card,
  .topbar {
    background: rgba(10, 18, 17, 0.88);
  }
}

